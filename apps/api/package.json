{
  "name": "@cnmcp/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "verify:local:all": "node bulk-probe.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "d1:local": "wrangler d1 migrations apply cnmcp --local",
    "d1:remote": "wrangler d1 migrations apply cnmcp --remote"
  },
  "dependencies": {
    "@cnmcp/checkers": "*",
    "@cnmcp/schema": "*",
    "hono": "4.13.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250906.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.38.0"
  }
}
